{
    servers {
        trusted_proxies static private_ranges
        trusted_proxies_strict
    }
}

:80 {
    @backend path /api /api/* /mcp /.well-known/oauth-protected-resource /.well-known/oauth-authorization-server

    handle @backend {
        reverse_proxy backend:8080
    }

    handle {
        reverse_proxy frontend:3000
    }
}
